# Local tooling (portable git etc.)
.tools/

# Dependencies
**/node_modules/
**/.venv/
**/dist/
**/.vite/

# Environment & secrets (keep *.example)
**/.env
**/.env.local
**/.env.*.local

# Python
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/*.egg-info/

# User-uploaded campaign datasets — local only, never commit
backend/storage/datasets/*.json
backend/storage/datasets/active.json

# Per-company management report configs
backend/storage/mgmt_configs/*.json

# Per-company data cleaning configs
backend/storage/cleaning_configs/*.json

# Logs & OS
*.log
.DS_Store
Thumbs.db

# IDE / editor
.vscode/
.idea/
*.swp
*.suo
